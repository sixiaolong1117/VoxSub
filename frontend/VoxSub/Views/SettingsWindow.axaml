<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxSub.ViewModels"
        xmlns:services="using:VoxSub.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="720"
        d:DesignHeight="420"
        x:Class="VoxSub.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{services:Localization Key=SettingsTitle}"
        Icon="/Assets/voxsub-icon.ico"
        Width="720"
        Height="420"
        MinWidth="640"
        MinHeight="380"
        Background="Transparent"
        TransparencyLevelHint="Mica,Blur">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="48,*,Auto">
        <Border Grid.Row="0" Classes="titleBar">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{services:Localization Key=Settings}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{services:Localization Key=SettingsSubtitle}"
                               Classes="statusText"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{services:Localization Key=RefreshDetect}"
                        Command="{Binding RefreshDetectedPathsCommand}"
                        MinWidth="88" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="16,12,16,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <Border Classes="settingsCard">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{services:Localization Key=BinaryPathsSection}" Classes="sectionTitle" />

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="96,*,Auto,Auto"
                              RowSpacing="4"
                              ColumnSpacing="6">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="ffmpeg"
                                       Classes="label" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding FfmpegPath}"
                                     Watermark="{services:Localization Key=FfmpegPlaceholder}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="{services:Localization Key=Browse}"
                                    Command="{Binding BrowseFfmpegCommand}"
                                    MinWidth="74" />
                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    Content="{services:Localization Key=Default}"
                                    Command="{Binding ResetFfmpegCommand}"
                                    MinWidth="64" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding FfmpegPathHint}"
                                       Classes="hint"
                                       Foreground="{Binding FfmpegPathHintColor}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="96,*,Auto,Auto"
                              RowSpacing="4"
                              ColumnSpacing="6">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Python"
                                       Classes="label" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding PythonPath}"
                                     Watermark="{services:Localization Key=PythonPlaceholder}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="{services:Localization Key=Browse}"
                                    Command="{Binding BrowsePythonCommand}"
                                    MinWidth="74" />
                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    Content="{services:Localization Key=Default}"
                                    Command="{Binding ResetPythonCommand}"
                                    MinWidth="64" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding PythonPathHint}"
                                       Classes="hint"
                                       Foreground="{Binding PythonPathHintColor}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="96,*,Auto,Auto"
                              RowSpacing="4"
                              ColumnSpacing="6">
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="VoxSub"
                                       Classes="label" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding VoxSubPath}"
                                     Watermark="{services:Localization Key=VoxSubPlaceholder}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Content="{services:Localization Key=Browse}"
                                    Command="{Binding BrowseVoxSubCommand}"
                                    MinWidth="74" />
                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    Content="{services:Localization Key=Default}"
                                    Command="{Binding ResetVoxSubCommand}"
                                    MinWidth="64" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="3"
                                       Text="{Binding VoxSubPathHint}"
                                       Classes="hint"
                                       Foreground="{Binding VoxSubPathHintColor}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="settingsCard">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{services:Localization Key=LanguageSettings}" Classes="sectionTitle" />

                        <Grid ColumnDefinitions="96,*" ColumnSpacing="6">
                            <TextBlock Grid.Column="0"
                                       Text="{services:Localization Key=Language}"
                                       Classes="label" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding LanguageOptions}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      MinWidth="140"
                                      HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource SystemAccentColor}"
                           Classes="statusText"
                           IsVisible="{Binding HasStatusText}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="titleBar"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="16,10"
                  ColumnSpacing="8">
                <TextBlock Text="{Binding StatusText}"
                           Classes="statusText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="{services:Localization Key=Close}"
                        Command="{Binding CancelCommand}"
                        MinWidth="82" />
                <Button Grid.Column="2"
                        Content="{services:Localization Key=Apply}"
                        Command="{Binding ApplyCommand}"
                        MinWidth="82" />
                <Button Grid.Column="3"
                        Content="{services:Localization Key=Save}"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        MinWidth="82" />
            </Grid>
        </Border>
    </Grid>
</Window>
