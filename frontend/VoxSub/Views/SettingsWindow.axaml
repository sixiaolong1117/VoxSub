<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoxSub.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="720"
        d:DesignHeight="420"
        x:Class="VoxSub.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="VoxSub 设置"
        Icon="/Assets/voxsub-icon.ico"
        Width="720"
        Height="420"
        MinWidth="640"
        MinHeight="380"
        Background="Transparent"
        TransparencyLevelHint="Mica,Blur">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="48,*,Auto">
        <Border Grid.Row="0" Classes="titleBar">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="设置"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="工具路径"
                               Classes="statusText"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="重新检测"
                        Command="{Binding RefreshDetectedPathsCommand}"
                        MinWidth="88" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="16,12,16,12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Classes="settingsCard">
                <StackPanel Spacing="14">
                    <TextBlock Text="二进制文件路径" Classes="sectionTitle" />

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="96,*,Auto,Auto"
                          RowSpacing="4"
                          ColumnSpacing="6">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="ffmpeg"
                                   Classes="label" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding FfmpegPath}"
                                 PlaceholderText="ffmpeg.exe" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="浏览..."
                                Command="{Binding BrowseFfmpegCommand}"
                                MinWidth="74" />
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="默认"
                                Command="{Binding ResetFfmpegCommand}"
                                MinWidth="64" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding FfmpegPathHint}"
                                   Classes="hint"
                                   Foreground="{Binding FfmpegPathHintColor}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="96,*,Auto,Auto"
                          RowSpacing="4"
                          ColumnSpacing="6">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="Python"
                                   Classes="label" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding PythonPath}"
                                 PlaceholderText="python.exe" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="浏览..."
                                Command="{Binding BrowsePythonCommand}"
                                MinWidth="74" />
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="默认"
                                Command="{Binding ResetPythonCommand}"
                                MinWidth="64" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding PythonPathHint}"
                                   Classes="hint"
                                   Foreground="{Binding PythonPathHintColor}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="96,*,Auto,Auto"
                          RowSpacing="4"
                          ColumnSpacing="6">
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="VoxSub"
                                   Classes="label" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding VoxSubPath}"
                                 PlaceholderText="voxsub.exe" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="浏览..."
                                Command="{Binding BrowseVoxSubCommand}"
                                MinWidth="74" />
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="默认"
                                Command="{Binding ResetVoxSubCommand}"
                                MinWidth="64" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="3"
                                   Text="{Binding VoxSubPathHint}"
                                   Classes="hint"
                                   Foreground="{Binding VoxSubPathHintColor}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource SystemAccentColor}"
                               Classes="statusText"
                               IsVisible="{Binding HasStatusText}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Classes="titleBar"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="16,10"
                  ColumnSpacing="8">
                <TextBlock Text="{Binding StatusText}"
                           Classes="statusText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Content="关闭"
                        Command="{Binding CancelCommand}"
                        MinWidth="82" />
                <Button Grid.Column="2"
                        Content="应用"
                        Command="{Binding ApplyCommand}"
                        MinWidth="82" />
                <Button Grid.Column="3"
                        Content="保存"
                        Command="{Binding SaveCommand}"
                        Classes="accent"
                        MinWidth="82" />
            </Grid>
        </Border>
    </Grid>
</Window>
