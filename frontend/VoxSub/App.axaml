<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxSub.App"
             xmlns:local="using:VoxSub"
             xmlns:services="using:VoxSub.Services"
             Name="VoxSub"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="关于 VoxSub"
                            Click="OpenAbout_Click" />
            <NativeMenuItem Header="设置..."
                            Click="OpenSettings_Click" />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/WinUI3Styles.axaml" />
    </Application.Styles>
</Application>
